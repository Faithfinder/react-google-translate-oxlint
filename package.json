{
  "name": "@faithfinder/oxlint-plugin-react-google-translate",
  "version": "0.3.0",
  "description": "Oxlint plugin that flags JSX patterns which crash React when the Google Translate browser extension is active. Fork of oxlint-plugin-react-google-translate with additional fixes.",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "react",
    "google-translate",
    "machine-translation",
    "lint",
    "jsx",
    "NotFoundError",
    "crash"
  ],
  "author": "Maksym Dolynchuk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faithfinder/react-google-translate-oxlint.git"
  },
  "homepage": "https://github.com/Faithfinder/react-google-translate-oxlint#readme",
  "bugs": {
    "url": "https://github.com/Faithfinder/react-google-translate-oxlint/issues"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.23.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "node --test"
  },
  "peerDependencies": {
    "oxlint": ">=1.47.0 <2"
  },
  "devDependencies": {
    "oxlint": "^1.69.0"
  }
}
